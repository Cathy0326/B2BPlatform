# Leave empty to use mock data. Set to the Spring Boot GraphQL endpoint for Phase 2.
NUXT_PUBLIC_GRAPHQL_URL=
# Optional: WebSocket endpoint for live auction updates (derived from the URL above when empty).
NUXT_PUBLIC_GRAPHQL_WS_URL=
# Auth0 (leave empty for demo mode). Domain e.g. your-tenant.us.auth0.com, audience = your API Identifier.
NUXT_PUBLIC_AUTH0_DOMAIN=
NUXT_PUBLIC_AUTH0_CLIENT_ID=
NUXT_PUBLIC_AUTH0_AUDIENCE=
# Server-side rendering inside Docker/Kubernetes: internal backend URL (browser keeps using the public one).
NUXT_GRAPHQL_URL_SERVER=
